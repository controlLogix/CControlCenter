{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command|shell_command|shell",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/agentmux-hook.sh\" pre-bash"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/agentmux-hook.sh\" pre-edit"
          }
        ]
      }
    ]
  }
}
