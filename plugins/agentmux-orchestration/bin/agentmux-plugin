#!/usr/bin/env python3
"""Maintained local replacement; original external plugin source was not recovered."""
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from gateway import Refused, loads
from policy import shell, edit
from roster_mcp import serve


def main():
    mode = sys.argv[1:]
    if mode == ["mcp"]:
        serve(sys.stdin.buffer, sys.stdout)
        return 0
    try:
        if mode not in (["pre-bash"], ["pre-edit"]):
            raise Refused("expected mcp, pre-bash or pre-edit")
        raw = sys.stdin.buffer.read(256 * 1024 + 1)
        if len(raw) > 256 * 1024:
            raise Refused("hook input exceeds the size limit")
        value = loads(raw.decode("utf-8"))
        if not isinstance(value, dict) or "tool_input" not in value:
            raise Refused("hook input needs a tool_input object")
        (shell if mode == ["pre-bash"] else edit)(value["tool_input"])
        return 0
    except (ValueError, OSError, RecursionError) as exc:
        print("agentmux hook: " + str(exc), file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
