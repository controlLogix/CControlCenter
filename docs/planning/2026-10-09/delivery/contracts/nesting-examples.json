  "cases": [
    {
      "id": "private-child-with-attenuated-actions",
      "errors": []
    },
    {
      "id": "private-child-wrong-parent",
      "changes": [
        {
          "path": [
            "child",
            "parent",
            "instanceId"
          ],
          "value": "other-parent"
        }
      ],
      "errors": [
        "parent_instance_binding"
      ]
    },
    {
      "id": "private-child-cannot-change-organization",
      "changes": [
        {
          "path": [
            "child",
            "effectiveGrant",
            "scope",
            "organizationId"
          ],
          "value": "other-org"
        }
      ],
      "errors": [
        "scope_escalation"
      ]
    },
    {
      "id": "private-child-cannot-add-action",
      "changes": [
        {
          "path": [
            "child",
            "effectiveGrant",
            "actions"
          ],
          "value": [
            "task-write"
          ]
        }
      ],
      "errors": [
        "capability_escalation"
      ]
    },
    {
      "id": "private-child-cannot-add-resource",
      "changes": [
        {
          "path": [
            "child",
            "effectiveGrant",
            "resourceIds"
          ],
          "value": [
            "task-two"
          ]
        }
      ],
      "errors": [
        "capability_escalation"
      ]
    },
    {
      "id": "private-child-cannot-outlive-parent",
      "changes": [
        {
          "path": [
            "child",
            "effectiveGrant",
            "expiresAt"
          ],
          "value": "2026-10-09T14:00:00Z"
        }
      ],
      "errors": [
        "grant_lifetime_escalation"
      ]
    },
    {
      "id": "private-child-cannot-reference-stale-parent-grant",
      "changes": [
        {
          "path": [
            "child",
            "effectiveGrant",
            "parentGrantRef",
            "revision"
          ],
          "value": 0
        }
      ],
      "errors": [
        "parent_grant_binding"
      ]
    },
    {
      "id": "private-child-cannot-reuse-parent-logger",
      "changes": [
        {
          "path": [
            "child",
            "services",
            "logger",
            "handleId"
          ],
          "value": "parent-handle-logger"
        }
      ],
      "errors": [
        "parent_service_handle_reused"
      ]
    },
    {
      "id": "private-installation-must-be-declared",
      "changes": [
        {
          "path": [
            "manifest",
            "installationModes"
          ],
          "value": [
            "independent"
          ]
        }
      ],
      "errors": [
        "installation_mode_or_package"
      ]
    },
    {
      "id": "independent-reference-does-not-inherit-parent-authority",
      "changes": [
        {
          "path": [
            "child",
            "parent",
            "relationship"
          ],
          "value": "independent-reference"
        },
        {
          "path": [
            "child",
            "effectiveGrant",
            "parentGrantRef"
          ],
          "value": null
        },
        {
          "path": [
            "child",
            "effectiveGrant",
            "scope",
            "projectId"
          ],
          "value": "other-project"
        }
      ],
      "errors": []
    }
