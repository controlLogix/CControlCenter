{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:planning:0.1:owner-record",
  "title": "Agentmux owner-record — P00 draft, not an approved runtime contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "recordId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "entityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "entityKind": {
      "enum": [
        "task",
        "delegation",
        "attempt",
        "effect",
        "approval",
        "project",
        "plugin-instance"
      ]
    },
    "ownerHubId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "ownerDomain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "entityVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "previousRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "operation": {
      "$ref": "urn:agentmux:planning:0.1:operation-context"
    },
    "recordedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "outcome": {
      "enum": [
        "committed",
        "rejected"
      ]
    },
    "state": {
      "type": "object"
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "effectId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,95}$"
          },
          "contractId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,95}$"
          },
          "payloadDigest": {
            "$ref": "urn:agentmux:planning:0.1:common#/$defs/digest"
          },
          "grantRef": {
            "$ref": "urn:agentmux:planning:0.1:common#/$defs/reference"
          },
          "recovery": {
            "enum": [
              "idempotent-retry",
              "query-before-retry",
              "human-reconciliation"
            ]
          },
          "payload": {
            "type": "object"
          }
        },
        "required": [
          "effectId",
          "contractId",
          "payloadDigest",
          "grantRef",
          "recovery",
          "payload"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "urn:agentmux:planning:0.1:common#/$defs/artifact"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "repository": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repositoryId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,95}$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "treeDigest": {
              "$ref": "urn:agentmux:planning:0.1:common#/$defs/digest"
            }
          },
          "required": [
            "repositoryId",
            "revision",
            "treeDigest"
          ]
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "recordId",
    "entityId",
    "entityKind",
    "ownerHubId",
    "ownerDomain",
    "entityVersion",
    "previousRevision",
    "operation",
    "recordedAt",
    "outcome",
    "state",
    "effects",
    "artifacts",
    "repository"
  ]
}
